<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<title>Bazaar — Faltantes</title>
<meta name="theme-color" content="#7a0b1e">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Bazaar">
<link rel="manifest" href="manifest.json">
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
:root{
  --bg:#fdf8f4;--bg2:#fff;--bg3:#fdf2f3;
  --border:#ede0d4;--border2:#f5c4c4;
  --text:#1a1a1a;--text2:#888;--text3:#b08070;--text4:#c4a898;
  --red:#7a0b1e;--red-light:#fdf2f3;
  --card-bg:#fff;--input-bg:#fff;--chip-bg:#fff;
  --modal-overlay:rgba(0,0,0,0.6);
}
body.dark{
  --bg:#111;--bg2:#1a1a1a;--bg3:#1f0a0e;
  --border:#2a2a2a;--border2:#4a1a1e;
  --text:#f0f0f0;--text2:#999;--text3:#c4a898;--text4:#555;
  --red:#e05555;--red-light:#1f0a0e;
  --card-bg:#1a1a1a;--input-bg:#222;--chip-bg:#222;
  --modal-overlay:rgba(0,0,0,0.8);
}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;overscroll-behavior:none;transition:background 0.3s,color 0.3s}
/* Header */
.header{position:fixed;top:0;left:0;right:0;z-index:100;background:var(--bg);border-bottom:0.5px solid var(--border);transition:transform 0.25s ease}
.header.hidden{transform:translateY(-100%)}
.header-top{padding:12px 16px 8px;display:flex;align-items:center;justify-content:space-between}
.logo{font-size:16px;font-weight:600;color:var(--red);letter-spacing:2px}
.header-meta{font-size:11px;color:var(--text3);background:var(--bg2);border:0.5px solid var(--border);border-radius:14px;padding:3px 10px}
.search-wrap{padding:0 12px 8px;position:relative}
.search-input{width:100%;background:var(--bg2);border:0.5px solid var(--border);border-radius:20px;padding:8px 14px 8px 36px;font-size:13px;color:var(--text);outline:none;font-family:inherit}
.search-input::placeholder{color:var(--text4)}
.search-icon{position:absolute;left:22px;top:50%;transform:translateY(-50%);color:var(--text4);font-size:14px;pointer-events:none}
.filter-row{padding:0 12px 10px;display:flex;gap:6px;overflow-x:auto;scrollbar-width:none}
.filter-row::-webkit-scrollbar{display:none}
.chip{background:var(--bg2);border:0.5px solid var(--border);border-radius:16px;padding:4px 12px;font-size:11px;color:var(--red);white-space:nowrap;cursor:pointer;transition:all 0.18s ease;font-family:inherit;font-weight:500}
.chip.active{background:var(--red) !important;border-color:var(--red) !important;color:#fff !important;transform:scale(1.04)}
@keyframes loadbar{0%{transform:translateX(-100%)}100%{transform:translateX(250%)}}
/* Dark mode overrides */
body.dark .upload-card{background:var(--bg2);border-color:var(--border)}
body.dark .btn-secondary{background:var(--bg2);border-color:var(--border);color:var(--text)}
body.dark .search-input{background:var(--input-bg)}
body.dark .chip{background:var(--chip-bg)}
body.dark .comment-input-wrap input{background:var(--input-bg);color:var(--text)}
body.dark .modal{background:var(--bg)}
body.dark .count-bar{background:var(--bg)}
body.dark #loading-screen{background:#111}
body.dark #loading-screen div:first-child{color:#e05555}
body.dark #loading-screen div:nth-child(2){color:#555}
body.dark #loading-screen > div:last-child{background:#222}
body.dark #loading-screen > div:last-child > div{background:#e05555}
/* Contador */
.count-bar{padding:6px 16px;font-size:11px;color:var(--text3);background:var(--bg);border-bottom:0.5px solid var(--border);display:flex;justify-content:space-between;align-items:center}
.count-bar strong{color:var(--red)}
.count-bar{color:var(--text3)}
/* Grid */
.grid-wrap{padding:8px;background:var(--bg)}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}
/* Card */
.card{background:var(--bg2);border-radius:14px;overflow:hidden;border:0.5px solid var(--border);transition:box-shadow 0.2s;display:flex;flex-direction:column}
.card:active{box-shadow:0 4px 20px rgba(122,11,30,0.12)}
.card.is-nok{outline:2px solid #ff3c3c;outline-offset:-2px}
.card.is-nok .card-img img,.card.is-nok .card-abbrev{filter:brightness(0.4) saturate(0.3)}
.card-img{aspect-ratio:1;background:var(--bg3);position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0}
.card-abbrev{font-size:22px;font-weight:600;color:var(--text4);pointer-events:none}
.btn-nok{position:absolute;bottom:6px;right:6px;width:22px;height:22px;border-radius:50%;background:rgba(122,11,30,0.85);border:none;color:#fff;font-size:11px;cursor:pointer;display:flex;align-items:center;justify-content:center}
.btn-compra{position:absolute;bottom:6px;left:6px;width:22px;height:22px;border-radius:50%;background:rgba(245,158,11,0.85);border:none;color:#fff;font-size:11px;cursor:pointer;display:flex;align-items:center;justify-content:center}
.btn-compra.ativo{background:rgba(245,158,11,1)}
.btn-eua{position:absolute;top:6px;right:6px;width:22px;height:22px;border-radius:50%;background:rgba(15,107,82,0.85);border:none;color:#fff;font-size:9px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center}
.btn-eua.ativo{background:rgba(15,107,82,1)}
.btn-br{position:absolute;top:32px;right:6px;width:22px;height:22px;border-radius:50%;background:rgba(120,72,30,0.85);border:none;color:#fff;font-size:9px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center}
.btn-br.ativo{background:rgba(120,72,30,1)}
.btn-comment{position:absolute;top:6px;left:6px;width:22px;height:22px;border-radius:50%;background:rgba(0,0,0,0.25);border:none;color:#fff;font-size:11px;cursor:pointer;display:flex;align-items:center;justify-content:center}
.card-body{padding:8px 10px 10px;display:flex;flex-direction:column;flex:1;min-height:120px}
.card-brand{font-size:9px;color:var(--red);font-weight:600;letter-spacing:0.8px;margin-bottom:2px;text-transform:uppercase}
.card-name{font-size:11px;font-weight:500;color:var(--text);line-height:1.35;margin-bottom:6px;cursor:pointer;flex:1}
.card-name:hover{color:#7a0b1e}
.card-footer{display:flex;justify-content:space-between;align-items:center;gap:4px;flex-wrap:nowrap}
.card-val{font-size:11px;color:var(--text2);white-space:nowrap}
/* Modal */
.modal-bg{display:none;position:fixed;inset:0;z-index:200;background:rgba(0,0,0,0);backdrop-filter:blur(0px);transition:background 0.25s,backdrop-filter 0.25s}
.modal-bg.open{display:flex;align-items:flex-end;background:var(--modal-overlay);backdrop-filter:blur(4px)}
.modal-bg.closing{background:rgba(0,0,0,0);backdrop-filter:blur(0px)}
.modal{background:var(--bg);border-radius:24px 24px 0 0;box-shadow:0 -8px 40px rgba(0,0,0,0.15);width:100%;max-height:85vh;overflow-y:auto;padding:20px 20px 90px;transform:translateY(100%);transition:transform 0.3s cubic-bezier(0.32,0.72,0,1)}
.modal-bg.open .modal{transform:translateY(0)}
.modal-bg.closing .modal{transform:translateY(100%)}
.modal-handle{width:36px;height:4px;background:var(--border);border-radius:2px;margin:0 auto 16px}
.modal-img{width:100%;aspect-ratio:1;border-radius:14px;background:var(--bg3);object-fit:cover;margin-bottom:14px;display:flex;align-items:center;justify-content:center;font-size:48px;font-weight:600;color:#d4b8a8}
.modal-brand{font-size:11px;color:var(--red);font-weight:600;letter-spacing:1px;text-transform:uppercase;margin-bottom:4px}
.modal-name{font-size:17px;font-weight:600;color:var(--text);margin-bottom:4px;line-height:1.3}
.modal-val{font-size:14px;color:var(--text2);margin-bottom:16px}
.modal-section{font-size:11px;font-weight:600;color:var(--text3);text-transform:uppercase;letter-spacing:1px;margin-bottom:8px}
/* Comments */
.comment-item{padding:8px 0;margin-bottom:0;border-bottom:0.5px solid var(--border)}
.comment-who{font-size:10px;color:var(--red);font-weight:600;margin-bottom:3px}
.comment-text{font-size:12px;color:var(--text);line-height:1.5}
.comment-time{font-size:9px;color:var(--text4);margin-top:4px}
.comment-input-wrap{display:flex;gap:8px;margin-top:12px}
.comment-input{flex:1;border:0.5px solid var(--border);border-radius:20px;padding:9px 14px;font-size:13px;font-family:inherit;outline:none;background:var(--bg2);color:var(--text)}
.comment-send{background:var(--red);border:none;border-radius:50%;width:36px;height:36px;color:#fff;font-size:16px;cursor:pointer;flex-shrink:0}
.modal-actions{display:flex;gap:8px;margin-top:16px}
.btn-primary{flex:1;background:var(--red);border:none;border-radius:12px;color:#fff;font-size:13px;font-weight:600;padding:12px;cursor:pointer;font-family:inherit}
.btn-secondary{flex:1;background:var(--red-light);border:0.5px solid var(--border2);border-radius:12px;color:var(--red);font-size:13px;font-weight:600;padding:12px;cursor:pointer;font-family:inherit}
.btn-edit{background:var(--bg);border:0.5px solid var(--border);border-radius:12px;color:var(--text2);font-size:13px;font-weight:500;padding:10px 16px;cursor:pointer;font-family:inherit;margin-bottom:12px;width:100%}
/* Tab bar */
.tab-bar{position:fixed;bottom:0;left:0;right:0;background:var(--bg2);border-top:0.5px solid var(--border);display:flex;padding-bottom:env(safe-area-inset-bottom,0);z-index:100}
.tab-btn{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;padding:8px 0 10px;background:none;border:none;cursor:pointer;font-family:inherit;position:relative}
.tab-icon{font-size:18px;color:var(--text3)}
.tab-label{font-size:9px;font-weight:600;color:var(--text4)}
.tab-btn.active .tab-label{color:var(--red)}
.tab-btn.active .tab-icon{color:var(--red)}
.tab-badge{position:absolute;top:4px;right:calc(50% - 18px);background:#7a0b1e;color:#fff;font-size:8px;font-weight:700;min-width:14px;height:14px;border-radius:7px;display:none;align-items:center;justify-content:center;padding:0 3px}
/* Chat page */
.page{display:none;position:fixed;inset:0;background:var(--bg);overflow-y:auto;padding-top:60px;padding-bottom:70px;opacity:0;transition:opacity 0.18s ease}
.page.active{display:block;opacity:1}
.page.active{display:block}
.chat-header{position:fixed;top:0;left:0;right:0;z-index:100;background:var(--bg);border-bottom:0.5px solid var(--border);padding:14px 16px;transition:top 0.2s}
.user-bar-visible .chat-header{top:38px}
.user-bar-visible .page{padding-top:98px}
.user-bar-visible .main-content{padding-top:208px}
.user-bar-visible #count-bar{padding-top:208px}
.chat-title{font-size:16px;font-weight:600;color:var(--text)}
.chat-sub{font-size:11px;color:var(--text3);margin-top:2px}
.chat-item{background:var(--bg2);border-left:3px solid var(--border);border-radius:0 12px 12px 0;margin:0 12px 8px;padding:10px 12px;cursor:pointer}
.chat-item.has-new{border-left-color:var(--red)}
.chat-item-name{font-size:12px;font-weight:600;color:var(--text);margin-bottom:4px}
.chat-item-last{font-size:11px;color:var(--text2);line-height:1.4}
.chat-item-meta{font-size:9px;color:#c4a898;margin-top:4px;display:flex;justify-content:space-between}
.chat-badge{background:var(--red);color:#fff;font-size:8px;font-weight:700;padding:1px 5px;border-radius:6px}
/* NOK overlay */
.nok-overlay{position:absolute;inset:0;display:none;align-items:center;justify-content:center;border-radius:0}
.nok-overlay.show{display:flex;animation:nokPop 0.25s ease}
@keyframes nokPop{0%{opacity:0}100%{opacity:1}}
.nok-overlay .nok-bg{position:absolute;inset:0;background:linear-gradient(to top,rgba(180,0,0,0.75) 0%,rgba(120,0,0,0.35) 60%,rgba(60,0,0,0.15) 100%)}
.nok-overlay .nok-content{position:relative;z-index:1;text-align:center}
.nok-label{color:#fff;font-size:11px;font-weight:700;letter-spacing:1px}
.compra-overlay{position:absolute;inset:0;display:none;align-items:center;justify-content:center;border-radius:0}
.compra-overlay.show{display:flex;animation:nokPop 0.25s ease}
.compra-overlay .compra-bg{position:absolute;inset:0;background:linear-gradient(to top,rgba(180,130,0,0.75) 0%,rgba(180,130,0,0.35) 60%,rgba(180,130,0,0.15) 100%)}
.compra-overlay .compra-content{position:relative;z-index:1;text-align:center}
.compra-label{color:#fff;font-size:11px;font-weight:700;letter-spacing:1px}
.eua-overlay{position:absolute;inset:0;display:none;align-items:center;justify-content:center;border-radius:0}
.eua-overlay.show{display:flex;animation:nokPop 0.25s ease}
.eua-overlay .eua-bg{position:absolute;inset:0;background:linear-gradient(to top,rgba(15,107,82,0.75) 0%,rgba(15,107,82,0.35) 60%,rgba(15,107,82,0.15) 100%)}
.eua-overlay .eua-content{position:relative;z-index:1;text-align:center}
.eua-label{color:#fff;font-size:11px;font-weight:700;letter-spacing:1px}
.br-overlay{position:absolute;inset:0;display:none;align-items:center;justify-content:center;border-radius:0}
.br-overlay.show{display:flex;animation:nokPop 0.25s ease}
.br-overlay .br-bg{position:absolute;inset:0;background:linear-gradient(to top,rgba(120,72,30,0.75) 0%,rgba(120,72,30,0.35) 60%,rgba(120,72,30,0.15) 100%)}
.br-overlay .br-content{position:relative;z-index:1;text-align:center}
.br-label{color:#fff;font-size:11px;font-weight:700;letter-spacing:1px}
/* Edit name inline */
.name-edit-row{display:flex;gap:6px;margin-bottom:6px}
.name-edit-input{flex:1;border:0.5px solid #f5c4c4;border-radius:8px;padding:5px 8px;font-size:11px;font-family:inherit;outline:none;background:#fdf2f3}
.name-save-btn{background:#7a0b1e;border:none;border-radius:8px;color:#fff;font-size:10px;font-weight:600;padding:5px 10px;cursor:pointer}
.name-cancel-btn{background:#fdf2f3;border:0.5px solid #f5c4c4;border-radius:8px;color:#7a0b1e;font-size:10px;padding:5px 8px;cursor:pointer}
/* Upload section */
.upload-page{padding:80px 16px 100px;background:var(--bg);min-height:100vh}
.upload-card{background:var(--bg2);border:0.5px solid var(--border);border-radius:16px;padding:20px;margin-bottom:12px}
.upload-title{font-size:14px;font-weight:600;color:var(--text);margin-bottom:6px}
.upload-sub{font-size:12px;color:var(--text3);margin-bottom:14px;line-height:1.5}
.upload-btn{width:100%;padding:12px;border-radius:12px;background:var(--red-light);border:0.5px dashed var(--border2);color:var(--red);font-family:inherit;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;text-align:center}
.progress-bar{height:4px;background:#ede0d4;border-radius:2px;margin-top:10px;overflow:hidden;display:none}
.progress-fill{height:100%;background:#7a0b1e;border-radius:2px;transition:width 0.3s;width:0%}
/* Firebase sync */
.sync-dot{width:6px;height:6px;border-radius:50%;background:#7a0b1e;display:inline-block;margin-right:4px}
/* Main content offset */
.main-content{padding-top:170px;padding-bottom:70px}
/* Empty */
.empty{text-align:center;padding:60px 20px;color:#c4a898;font-size:14px}
/* Reaction bar */
.reaction-bar{display:flex;gap:8px;margin-top:10px}
.reaction-btn{background:#fdf8f4;border:0.5px solid #ede0d4;border-radius:20px;padding:5px 12px;font-size:12px;cursor:pointer;font-family:inherit}
.reaction-btn.active{background:#fdf2f3;border-color:#f5c4c4}
</style>
</head>
<body>

<!-- HEADER (catálogo) -->
<!-- LOGIN OVERLAY -->
<div id="login-overlay" style="display:none;position:fixed;inset:0;z-index:9999;background:var(--bg);align-items:center;justify-content:center;flex-direction:column;padding:40px 24px">
  <div style="font-size:28px;font-weight:700;color:#7a0b1e;letter-spacing:3px;margin-bottom:8px">BAZAAR</div>
  <div style="font-size:13px;color:#c4a898;margin-bottom:40px">Faltantes</div>
  <div style="background:#fff;border:0.5px solid #ede0d4;border-radius:20px;padding:28px 24px;width:100%;max-width:320px;text-align:center">
    <div style="font-size:15px;font-weight:600;color:#1a1a1a;margin-bottom:6px">Entrar</div>
    <div style="font-size:12px;color:#c4a898;margin-bottom:24px">Use sua conta Google</div>
    <button onclick="loginGoogle()" style="width:100%;padding:13px;border-radius:12px;background:#fff;border:0.5px solid #ede0d4;font-size:13px;font-weight:600;color:#1a1a1a;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px;font-family:inherit">
      <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
      Continuar com Google
    </button>
  </div>
  <div id="login-error" style="font-size:11px;color:#c0392b;margin-top:12px;text-align:center"></div>
</div>

<!-- LOADING SCREEN -->
<div id="loading-screen" style="position:fixed;inset:0;z-index:9998;background:#f9f2ee;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px">
  <div style="font-size:28px;font-weight:800;color:#7a0b1e;letter-spacing:-1px">bazaar</div>
  <div style="font-size:13px;color:#c4a898">Conectando...</div>
  <div style="width:40px;height:4px;background:#ede0d4;border-radius:4px;overflow:hidden">
    <div style="height:100%;width:40%;background:#7a0b1e;border-radius:4px;animation:loadbar 1s ease-in-out infinite alternate"></div>
  </div>
</div>

<!-- OFFLINE BANNER -->
<div id="offline-banner" style="display:none;position:fixed;top:0;left:0;right:0;z-index:9997;background:#1a1a1a;color:#fff;font-size:12px;font-weight:600;text-align:center;padding:8px;letter-spacing:0.3px">
  ⚠️ Sem conexão — alterações serão salvas quando voltar
</div>

<!-- USER BAR -->
<div id="user-bar" style="position:fixed;top:0;left:0;right:0;z-index:101;background:#7a0b1e;padding:6px 14px;display:none;align-items:center;justify-content:space-between">
  <div style="display:flex;align-items:center;gap:8px">
    <div style="position:relative">
      <div id="user-avatar-wrap" style="width:28px;height:28px;border-radius:50%;border:1.5px solid rgba(255,255,255,0.5);overflow:hidden;background:rgba(255,255,255,0.25);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:#fff">
        <img id="user-avatar" src="" style="width:100%;height:100%;object-fit:cover;display:none">
        <span id="user-avatar-init"></span>
      </div>
      <div style="position:absolute;bottom:0;right:0;width:8px;height:8px;border-radius:50%;background:#28c850;border:1.5px solid #7a0b1e"></div>
    </div>
    <span id="user-name" style="font-size:11px;color:rgba(255,255,255,0.9);font-weight:600"></span>
  </div>
  <div style="display:flex;align-items:center;gap:8px">
    <div id="online-users" style="display:flex;align-items:center;gap:4px"></div>
    <button onclick="logoutGoogle()" style="background:rgba(255,255,255,0.15);border:none;border-radius:8px;color:#fff;font-size:10px;padding:4px 10px;cursor:pointer">Sair</button>
  </div>
</div>

<div class="header" id="cat-header">
  <div class="header-top">
    <div>
      <span class="logo">BAZAAR</span>
      <div id="subtitulo" onclick="editarSubtitulo()" style="font-size:10px;color:#b08070;margin-top:1px;cursor:pointer;letter-spacing:0.5px" title="Clique para editar">Faltantes — Junho 2026</div>
    </div>
    <div style="display:flex;align-items:center;gap:8px">
      <button onclick="toggleDark()" id="btn-dark" style="background:var(--bg2);border:0.5px solid var(--border);border-radius:10px;padding:4px 8px;cursor:pointer;font-size:14px;color:var(--red)" title="Modo escuro">🌙</button>
      <button onclick="toggleGrid()" id="btn-grid" style="background:#fff;border:0.5px solid #ede0d4;border-radius:10px;padding:4px 8px;cursor:pointer;font-size:14px;color:#7a0b1e" title="Mudar visualização">⊞</button>
      <div style="display:flex;flex-direction:column;align-items:flex-end;gap:1px">
      <span class="header-meta" id="header-meta">231 itens · R$ 48.959,50</span>
      <span id="header-total" style="font-size:9px;color:var(--text4)"></span>
      <span id="header-vend-total" style="font-size:9px;color:var(--red);font-weight:600;display:none"></span>
      <span id="header-compra" style="font-size:9px;color:#f59e0b;font-weight:600;display:none"></span>
    </div>
    </div>
  </div>
  <div class="search-wrap">
    <span class="search-icon">🔍</span>
    <input class="search-input" id="search-input" type="text" placeholder="Buscar produto, marca, vendedora..." oninput="renderGrid()" autocomplete="off">
  </div>
  <div style="display:flex;gap:8px;padding:8px 12px 4px">
    <button class="chip active" id="chip-origem-todos" onclick="setOrigem('',this)" style="flex:1;justify-content:center">Todos</button>
    <button class="chip" id="chip-origem-br" onclick="setOrigem('br',this)" style="flex:1;justify-content:center">🇧🇷 <span id="label-mes-br" onclick="event.stopPropagation();editarMesLabel('br')">Mês BR</span></button>
    <button class="chip" id="chip-origem-usa" onclick="setOrigem('usa',this)" style="flex:1;justify-content:center">🇺🇸 <span id="label-mes-usa" onclick="event.stopPropagation();editarMesLabel('usa')">Mês USA</span></button>
  </div>
  <div class="filter-row" id="vend-row">
    <button class="chip active" id="chip-todas" onclick="setVend('TODAS',this)">Todas</button>
    <button class="chip" onclick="setVend('FABIANA',this)">Fabiana</button><button class="chip" onclick="setVend('JÉSSICA',this)">Jéssica</button><button class="chip" onclick="setVend('SABRINA',this)">Sabrina</button><button class="chip" onclick="setVend('THAIS',this)">Thais</button>
  </div>
  <div style="padding:0 12px 6px;position:relative">
    <input id="marca-search" type="text" placeholder="Buscar marca..." autocomplete="off"
      style="width:100%;background:#fff;border:0.5px solid #ede0d4;border-radius:16px;padding:5px 12px 5px 28px;font-size:11px;color:#1a1a1a;outline:none;font-family:inherit"
      oninput="filtrarMarcaChips(this.value)">
    <span style="position:absolute;left:20px;top:50%;transform:translateY(-50%);font-size:11px;color:#c4a898;pointer-events:none">🔍</span>
  </div>
  <div style="padding:0 12px 4px">
    <div style="font-size:9px;font-weight:600;color:var(--text4);text-transform:uppercase;letter-spacing:0.8px;margin-bottom:4px">Categoria</div>
  <div class="filter-row" id="cat-row">
      <button class="chip active" id="chip-all-cat" onclick="setCat('',this)">Todas</button><button class="chip" onclick="setCat('ACESSÓRIOS',this)">ACESSÓRIOS</button><button class="chip" onclick="setCat('ALIMENTICIO',this)">ALIMENTICIO</button><button class="chip" onclick="setCat('CALÇADO FEMININO',this)">CALÇADO FEMININO</button><button class="chip" onclick="setCat('CALÇADO MASCULINO',this)">CALÇADO MASCULINO</button><button class="chip" onclick="setCat('CASA',this)">CASA</button><button class="chip" onclick="setCat('COSMÉTICOS',this)">COSMÉTICOS</button><button class="chip" onclick="setCat('FARMÁCIA',this)">FARMÁCIA</button><button class="chip" onclick="setCat('FEMININO',this)">FEMININO</button><button class="chip" onclick="setCat('INFANTIL',this)">INFANTIL</button><button class="chip" onclick="setCat('MASCULINO',this)">MASCULINO</button><button class="chip" onclick="setCat('PERFUMARIA',this)">PERFUMARIA</button><button class="chip" onclick="setCat('ROUPA INFANTIL',this)">ROUPA INFANTIL</button>
    </div>
  </div>
  <div class="filter-row" id="sort-row">
    <button class="chip active" id="sort-marca" onclick="setSort('marca',this)">Marca A→Z</button>
    <button class="chip" id="sort-valor-asc" onclick="setSort('valor-asc',this)">Valor ↑</button>
    <button class="chip" id="sort-valor-desc" onclick="setSort('valor-desc',this)">Valor ↓</button>
    <button class="chip" id="sort-qty-asc" onclick="setSort('qty-asc',this)">Qtd ↑</button>
    <button class="chip" id="sort-qty-desc" onclick="setSort('qty-desc',this)">Qtd ↓</button>
  </div>
  <div class="filter-row" id="status-row">
    <button class="chip active" id="status-todos" onclick="setStatus('',this)">Todos</button>
    <button class="chip" id="status-nok" onclick="setStatus('nok',this)">✕ NOK</button>
    <button class="chip" id="status-compra" onclick="setStatus('compra',this)">🛒 Compra</button>
    <button class="chip" id="status-eua" onclick="setStatus('eua',this)">🇺🇸 EUA</button>
    <button class="chip" id="status-br" onclick="setStatus('br',this)">🇧🇷 BR</button>
  </div>
  <div class="filter-row" id="marca-row">
    <button class="chip active" id="chip-all-marca" onclick="setMarca('',this)">Todas marcas</button>
    <button class="chip" onclick="setMarca('32 DEGREES',this)">32 DEGREES</button><button class="chip" onclick="setMarca('ADIDAS',this)">ADIDAS</button><button class="chip" onclick="setMarca('AERIE',this)">AERIE</button><button class="chip" onclick="setMarca('BABE LASH',this)">BABE LASH</button><button class="chip" onclick="setMarca('BALANCE',this)">BALANCE</button><button class="chip" onclick="setMarca('BANANA REPUBLIC',this)">BANANA REPUBLIC</button><button class="chip" onclick="setMarca('BB',this)">BB</button><button class="chip" onclick="setMarca('BBW',this)">BBW</button><button class="chip" onclick="setMarca('BENADRYL',this)">BENADRYL</button><button class="chip" onclick="setMarca('BI-FLEX',this)">BI-FLEX</button><button class="chip" onclick="setMarca('BIOPURE',this)">BIOPURE</button><button class="chip" onclick="setMarca('BLUE LOVE',this)">BLUE LOVE</button><button class="chip" onclick="setMarca('BOMBAY',this)">BOMBAY</button><button class="chip" onclick="setMarca('BOOGIE',this)">BOOGIE</button><button class="chip" onclick="setMarca('CALVIN KLEIN',this)">CALVIN KLEIN</button><button class="chip" onclick="setMarca('CARTERS',this)">CARTERS</button><button class="chip" onclick="setMarca('CENTELLA',this)">CENTELLA</button><button class="chip" onclick="setMarca('CHARLOTTE',this)">CHARLOTTE</button><button class="chip" onclick="setMarca('COLUMBIA',this)">COLUMBIA</button><button class="chip" onclick="setMarca('CONVERSE',this)">CONVERSE</button><button class="chip" onclick="setMarca('CORE KITCHEN',this)">CORE KITCHEN</button><button class="chip" onclick="setMarca('DERMASIL',this)">DERMASIL</button><button class="chip" onclick="setMarca('EGG TIMER',this)">EGG TIMER</button><button class="chip" onclick="setMarca('EPIELLE',this)">EPIELLE</button><button class="chip" onclick="setMarca('FASHION NOVA',this)">FASHION NOVA</button><button class="chip" onclick="setMarca('GAP',this)">GAP</button><button class="chip" onclick="setMarca('GLORIA VANDERBILT',this)">GLORIA VANDERBILT</button><button class="chip" onclick="setMarca('GREAT VALUE',this)">GREAT VALUE</button><button class="chip" onclick="setMarca('JESSICA SIMPSON',this)">JESSICA SIMPSON</button><button class="chip" onclick="setMarca('JOURNEE',this)">JOURNEE</button><button class="chip" onclick="setMarca('JUICY COUTURE',this)">JUICY COUTURE</button><button class="chip" onclick="setMarca('K18',this)">K18</button><button class="chip" onclick="setMarca('KEITH HARING',this)">KEITH HARING</button><button class="chip" onclick="setMarca('KITCHENAID',this)">KITCHENAID</button><button class="chip" onclick="setMarca('LA COLORS',this)">LA COLORS</button><button class="chip" onclick="setMarca('LAURA ASHLEY',this)">LAURA ASHLEY</button><button class="chip" onclick="setMarca('LOREAL',this)">LOREAL</button><button class="chip" onclick="setMarca('MARIE CLAIRE PARIS',this)">MARIE CLAIRE PARIS</button><button class="chip" onclick="setMarca('MARIO BADESCU',this)">MARIO BADESCU</button><button class="chip" onclick="setMarca('MELISSA E DOUG',this)">MELISSA E DOUG</button><button class="chip" onclick="setMarca('MONDAY',this)">MONDAY</button><button class="chip" onclick="setMarca('MONDETTA',this)">MONDETTA</button><button class="chip" onclick="setMarca('MR BUBBLE',this)">MR BUBBLE</button><button class="chip" onclick="setMarca('NATROL',this)">NATROL</button><button class="chip" onclick="setMarca('OLD NAVY',this)">OLD NAVY</button><button class="chip" onclick="setMarca('OLD NAVY X GAP',this)">OLD NAVY X GAP</button><button class="chip" onclick="setMarca('PARK LIFE',this)">PARK LIFE</button><button class="chip" onclick="setMarca('RALPH LAUREN',this)">RALPH LAUREN</button><button class="chip" onclick="setMarca('RUSSEL STOVER',this)">RUSSEL STOVER</button><button class="chip" onclick="setMarca('SINOPANT',this)">SINOPANT</button><button class="chip" onclick="setMarca('SKECHERS',this)">SKECHERS</button><button class="chip" onclick="setMarca('SMART CARE',this)">SMART CARE</button><button class="chip" onclick="setMarca('SNUGGLE',this)">SNUGGLE</button><button class="chip" onclick="setMarca('STEVE MADDEN',this)">STEVE MADDEN</button><button class="chip" onclick="setMarca('TOMMY',this)">TOMMY</button><button class="chip" onclick="setMarca('VASELINE',this)">VASELINE</button><button class="chip" onclick="setMarca(&quot;VICTORIA'S SECRET&quot;,this)">VICTORIA'S SECRET</button><button class="chip" onclick="setMarca('VOLCOM',this)">VOLCOM</button><button class="chip" onclick="setMarca('WALYFREI',this)">WALYFREI</button><button class="chip" onclick="setMarca('WET',this)">WET</button>
  </div>
</div>

<!-- CONTADOR -->
<div class="count-bar main-content" id="count-bar" style="padding-top:170px">
  <span>Mostrando <strong id="count-num">231</strong> faltantes</span>
  <span id="count-val"></span>
</div>

<!-- GRID -->
<div class="grid-wrap" style="padding-top:4px">
  <div class="grid" id="grid"></div>
  <div class="empty" id="empty" style="display:none">Nenhum produto encontrado</div>
</div>

<!-- CHAT PAGE -->
<div class="page" id="page-chat">
  <div class="chat-header">
    <div class="chat-title">Notificações</div>
    <div class="chat-sub" id="chat-sub">Todos os produtos</div>
  </div>
  <div style="padding:12px 0" id="chat-list"></div>
</div>

<!-- UPLOAD PAGE -->
<div class="page" id="page-upload">
  <div class="upload-page">
    <div class="upload-card">
      <div class="upload-title">🇺🇸 Importar Planilha USA</div>
      <div class="upload-sub">Importe o CSV da planilha EUA para atualizar os produtos faltantes dessa origem.</div>
      <label class="upload-btn">
        ⬆ Selecionar CSV USA
        <input type="file" accept=".csv" style="display:none" onchange="processarCSVUSA(this)">
      </label>
      <div class="progress-bar" id="csv-progress"><div class="progress-fill" id="csv-fill"></div></div>
      <div id="csv-status" style="font-size:11px;color:#b08070;margin-top:8px"></div>
    </div>
    <div class="upload-card">
      <div class="upload-title">🇧🇷 Importar Planilha BR</div>
      <div class="upload-sub">Importe o CSV da planilha BR (itens marcados como "IA" — Ir Atrás) para atualizar os produtos dessa origem.</div>
      <label class="upload-btn">
        ⬆ Selecionar CSV BR
        <input type="file" accept=".csv" style="display:none" onchange="processarCSVBR(this)">
      </label>
      <div class="progress-bar" id="csv-progress-br"><div class="progress-fill" id="csv-fill-br"></div></div>
      <div id="csv-status-br" style="font-size:11px;color:#b08070;margin-top:8px"></div>
    </div>
    <div class="upload-card">
      <div class="upload-title">🖼 Atualizar fotos</div>
      <div class="upload-sub">Importe o CSV de IDs de fotos do Google Drive.</div>
      <label class="upload-btn">
        ⬆ Selecionar CSV de fotos
        <input type="file" accept=".csv" style="display:none" onchange="handleFotos(this)">
      </label>
      <div id="foto-status" style="font-size:11px;color:#b08070;margin-top:8px"></div>
    </div>
    <div class="upload-card">
      <div class="upload-title">📄 Gerar PDF</div>
      <div class="upload-sub">Gere uma lista de faltantes filtrada por marca e vendedora.</div>
      <div style="margin-bottom:10px">
        <div style="font-size:10px;font-weight:600;color:#b08070;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:5px">Vendedora</div>
        <select id="pdf-vend" style="width:100%;background:#fdf8f4;border:0.5px solid #ede0d4;border-radius:10px;padding:9px 12px;font-size:13px;font-family:inherit;outline:none;color:#1a1a1a">
          <option value="">Todas</option>
        </select>
      </div>
      <div style="margin-bottom:14px">
        <div style="font-size:10px;font-weight:600;color:#b08070;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:6px">Marca</div>
        <div style="position:relative;margin-bottom:6px">
          <input id="pdf-marca-search" type="text" placeholder="Buscar marca..." autocomplete="off"
            oninput="filtrarPdfMarcas(this.value)"
            style="width:100%;background:#fdf8f4;border:0.5px solid #ede0d4;border-radius:10px;padding:7px 12px 7px 28px;font-size:12px;font-family:inherit;outline:none;color:#1a1a1a">
          <span style="position:absolute;left:9px;top:50%;transform:translateY(-50%);font-size:11px;color:#c4a898;pointer-events:none">🔍</span>
        </div>
        <div style="display:flex;gap:6px;margin-bottom:6px">
          <button onclick="selecionarTodasMarcasPDF()" style="font-size:9px;font-weight:600;color:#7a0b1e;background:#fdf2f3;border:0.5px solid #f5c4c4;border-radius:8px;padding:3px 10px;cursor:pointer;font-family:inherit">Todas</button>
          <button onclick="limparMarcasPDF()" style="font-size:9px;font-weight:600;color:#888;background:#fff;border:0.5px solid #ede0d4;border-radius:8px;padding:3px 10px;cursor:pointer;font-family:inherit">Limpar</button>
        </div>
        <div id="pdf-marcas-chips" style="display:flex;flex-wrap:wrap;gap:5px;max-height:120px;overflow-y:auto"></div>
      </div>
      <button onclick="gerarPDF()" style="width:100%;padding:12px;border-radius:12px;background:#7a0b1e;border:none;color:#fff;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit">↓ Gerar PDF</button>
    </div>
    <div id="ultima-atualizacao" style="font-size:11px;color:#c4a898;text-align:center;margin-top:8px"></div>
    <div class="upload-card" style="margin-top:12px">
      <div class="upload-title">🏷️ Nome da versão</div>
      <div class="upload-sub">Dê um nome para esta versão e sincronize com todas.</div>
      <div style="display:flex;gap:8px;margin-top:4px">
        <input id="csv-versao-nome" type="text" placeholder="Ex: Faltantes — Julho 2026"
          style="flex:1;border:0.5px solid #ede0d4;border-radius:10px;padding:9px 12px;font-size:13px;font-family:inherit;outline:none;background:#fdf8f4;color:#1a1a1a">
        <button onclick="salvarVersao()" style="padding:9px 14px;border-radius:10px;background:#7a0b1e;border:none;color:#fff;font-size:12px;font-weight:700;cursor:pointer;font-family:inherit;white-space:nowrap">Salvar</button>
      </div>
      <div id="versao-status" style="font-size:11px;color:#b08070;margin-top:6px"></div>
    </div>
    <div class="upload-card" style="margin-top:12px">
      <div class="upload-title">📋 Histórico de versões</div>
      <div id="version-list" style="margin-top:8px"></div>
    </div>
    <div style="margin-top:12px;padding:0 0 4px">
      <button onclick="abrirModalAdd()" style="width:100%;padding:13px;border-radius:14px;background:var(--red);border:none;color:#fff;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:8px">
        + Adicionar item manualmente
      </button>
    </div>
    <div style="margin-top:12px;padding:12px 16px;border-top:0.5px solid var(--border)">
      <div style="font-size:10px;color:var(--text4);font-weight:600;letter-spacing:0.5px;margin-bottom:8px">FIREBASE</div>
      <div id="fb-usage" style="font-size:11px;color:var(--text3)">Calculando...</div>
      <a href="https://console.firebase.google.com" target="_blank" style="font-size:10px;color:var(--text4);text-decoration:none;display:block;margin-top:6px">Ver console completo ↗</a>
    </div>
    <div style="margin-top:12px;border-top:0.5px solid var(--border)">
      <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px 6px">
        <div style="font-size:10px;color:var(--text4);font-weight:600;letter-spacing:0.5px">HISTÓRICO</div>
        <div style="display:flex;gap:6px">
          <button onclick="limparHistorico()" style="background:none;border:0.5px solid var(--border);border-radius:8px;padding:4px 10px;color:var(--text3);font-size:10px;font-weight:600;cursor:pointer;font-family:inherit">🗑 Limpar</button>
          <button onclick="setHistView('timeline')" id="hist-btn-timeline" class="chip active" style="font-size:9px;padding:4px 10px">Timeline</button>
          <button onclick="setHistView('relatorio')" id="hist-btn-relatorio" class="chip" style="font-size:9px;padding:4px 10px">Semanal</button>
        </div>
      </div>
      <div id="hist-timeline" style="padding:4px 0"></div>
      <div id="hist-relatorio" style="padding:8px 16px;display:none"></div>
    </div>
  </div>
</div>

<!-- FAB ADD (moved to Dados page) -->

<!-- MODAL ADD ITEM -->
<div id="modal-add-bg" style="display:none;position:fixed;inset:0;z-index:300;background:rgba(50,20,10,0.4);backdrop-filter:blur(3px);align-items:flex-end;justify-content:center" onclick="if(event.target===this)fecharModalAdd()">
  <div style="background:#fff;border-radius:24px 24px 0 0;width:100%;padding:20px 20px 40px">
    <div style="width:36px;height:4px;background:#ede0d4;border-radius:2px;margin:0 auto 16px"></div>
    <div style="font-size:15px;font-weight:700;color:#1a1a1a;margin-bottom:16px">Adicionar item</div>
    <div style="margin-bottom:12px">
      <div style="font-size:10px;font-weight:600;color:#b08070;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:5px">Nome do produto</div>
      <input id="add-nome" type="text" placeholder="Ex: Jaqueta Columbia azul" autocomplete="off"
        style="width:100%;border:0.5px solid #ede0d4;border-radius:12px;padding:10px 14px;font-size:13px;font-family:inherit;outline:none;background:#fdf8f4;color:#1a1a1a">
    </div>
    <div style="margin-bottom:12px">
      <div style="font-size:10px;font-weight:600;color:#b08070;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:5px">Marca</div>
      <input id="add-marca" type="text" placeholder="Ex: Columbia" autocomplete="off"
        style="width:100%;border:0.5px solid #ede0d4;border-radius:12px;padding:10px 14px;font-size:13px;font-family:inherit;outline:none;background:#fdf8f4">
    </div>
    <div style="margin-bottom:12px">
      <div style="font-size:10px;font-weight:600;color:#b08070;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:6px">Tamanhos</div>
      <div id="add-tams-list" style="display:flex;flex-direction:column;gap:6px;margin-bottom:6px"></div>
      <button onclick="adicionarTamanho()" style="width:100%;padding:8px;border-radius:10px;background:#fdf8f4;border:0.5px dashed #ede0d4;color:#b08070;font-size:12px;cursor:pointer;font-family:inherit">+ Adicionar tamanho</button>
    </div>
    <div style="margin-bottom:16px">
      <div style="font-size:10px;font-weight:600;color:#b08070;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:5px">Valor (opcional)</div>
      <input id="add-valor" type="number" placeholder="0,00" step="0.01"
        style="width:100%;border:0.5px solid #ede0d4;border-radius:12px;padding:10px 14px;font-size:13px;font-family:inherit;outline:none;background:#fdf8f4">
    </div>
    <div style="margin-bottom:16px">
      <div style="font-size:10px;font-weight:600;color:#b08070;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:5px">Foto (opcional)</div>
      <label style="display:flex;align-items:center;gap:10px;cursor:pointer">
        <div id="add-foto-preview" style="width:56px;height:56px;border-radius:10px;background:#fdf2f3;border:0.5px dashed #f5c4c4;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;overflow:hidden">📷</div>
        <div style="flex:1">
          <div style="font-size:12px;color:#7a0b1e;font-weight:600">Tirar foto ou escolher</div>
          <div style="font-size:10px;color:#c4a898;margin-top:2px">JPG, PNG até 5MB</div>
        </div>
        <input type="file" accept="image/*" capture="environment" style="display:none" onchange="previewFoto(this)" id="add-foto-input">
      </label>
    </div>
    <div style="display:flex;gap:8px">
      <button onclick="fecharModalAdd()" style="flex:1;padding:13px;border-radius:12px;background:#fdf8f4;border:0.5px solid #ede0d4;color:#888;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit">Cancelar</button>
      <button onclick="salvarNovoItem()" style="flex:2;padding:13px;border-radius:12px;background:#7a0b1e;border:none;color:#fff;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit">Adicionar</button>
    </div>
  </div>
</div>

<!-- TAB BAR -->
<div class="tab-bar">
  <button class="tab-btn active" id="tab-cat" onclick="goTab('cat')">
    <span class="tab-icon">⊞</span>
    <span class="tab-label">Catálogo</span>
  </button>
  <button class="tab-btn" id="tab-compra" onclick="goTab('compra')" style="position:relative">
    <span class="tab-badge" id="compra-badge" style="background:#f59e0b">0</span>
    <span class="tab-icon">🛒</span>
    <span class="tab-label">Em compra</span>
  </button>
  <button class="tab-btn" id="tab-eua" onclick="goTab('eua')" style="position:relative">
    <span class="tab-badge" id="eua-badge" style="background:#0f6b52">0</span>
    <span class="tab-icon">🌎</span>
    <span class="tab-label">Estoques</span>
