        <button onclick="compartilharLink()" style="flex:1;padding:12px;border-radius:12px;background:#6366f1;border:none;color:#fff;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit">🔗 Link</button>
        <button onclick="baixarPdfProduto()" style="flex:1;padding:12px;border-radius:12px;background:var(--red);border:none;color:#fff;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit">↓ PDF</button>
