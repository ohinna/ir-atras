        <button class="btn-secondary" onclick="toggleNok()" style="flex:1;padding:12px">✕ NOK</button>
        <button id="btn-em-compra" onclick="toggleEmCompra()" style="flex:1;padding:12px;border-radius:12px;background:#f59e0b;border:none;color:#fff;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit">🛒 Em compra</button>
