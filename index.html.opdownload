<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-auth-compat.js"></script>
<script>
const _fbConfig = {
  apiKey: "AIzaSyCy6NWVuvC1nVsX5fV53b9DpmKqFzwI2tc",
  authDomain: "ir-atras.firebaseapp.com",
  projectId: "ir-atras",
  storageBucket: "ir-atras.firebasestorage.app",
  messagingSenderId: "427877333576",
  appId: "1:427877333576:web:981459abeaad210fa5b67d"
};
if (typeof firebase !== 'undefined' && !firebase.apps.length) firebase.initializeApp(_fbConfig);
window._db = typeof firebase !== 'undefined' ? firebase.firestore() : null;

const RAW_DATA = [];

let PRODUTOS = RAW_DATA.map((p,i) => ({...p, _id:i, nok:false, em_compra:false, comments:[], qty: p.q}));
// Restaurar filtros salvos
function salvarFiltros() {
  localStorage.setItem('filtros', JSON.stringify({
    vends: [...fVends], marcas: [...fMarcas], cat: fCat, sortMode: _sortMode, sortDir: _sortDir, status: fStatus, origem: fOrigem
  }));
}

function restaurarFiltros() {
  try {
    const saved = JSON.parse(localStorage.getItem('filtros'));
    if (!saved) return;
    if (saved.vends) fVends = new Set(saved.vends);
    if (saved.marcas) fMarcas = new Set(saved.marcas);
    if (saved.cat) fCat = saved.cat;
    if (saved.sortMode) _sortMode = saved.sortMode;
    if (saved.sortDir) _sortDir = saved.sortDir;
    // Atualizar chips de vendedora
    document.querySelectorAll('#vend-row .chip').forEach(c => c.classList.remove('active'));
    if (fVends.has('TODAS')) {
      document.getElementById('chip-todas')?.classList.add('active');
    } else {
      fVends.forEach(v => {
        document.querySelectorAll('#vend-row .chip').forEach(c => {
          if (c.textContent.trim().toUpperCase() === v) c.classList.add('active');
        });
      });
    }
    // Atualizar chips de marca
    document.querySelectorAll('#marca-row .chip').forEach(c => c.classList.remove('active'));
    if (fMarcas.size === 0) {
      document.getElementById('chip-all-marca')?.classList.add('active');
    } else {
      fMarcas.forEach(m => {
        document.querySelectorAll('#marca-row .chip').forEach(c => {
          if (c.textContent.trim() === m) c.classList.add('active');
        });
      });
    }
    if (saved.status !== undefined) fStatus = saved.status;
    // Atualizar chip de status
    document.querySelectorAll('#status-row .chip').forEach(c => c.classList.remove('active'));
    const statusId = saved.status ? 'status-'+saved.status : 'status-todos';
    document.getElementById(statusId)?.classList.add('active');
    if (saved.origem !== undefined) fOrigem = saved.origem;
    document.querySelectorAll('#chip-origem-todos, #chip-origem-br, #chip-origem-usa').forEach(c => c.classList.remove('active'));
    const origemId = saved.origem ? 'chip-origem-'+saved.origem : 'chip-origem-todos';
    document.getElementById(origemId)?.classList.add('active');
    const sortMap = {'marca-asc':'sort-marca','valor-asc':'sort-valor-asc','valor-desc':'sort-valor-desc','qty-asc':'sort-qty-asc','qty-desc':'sort-qty-desc'};
    const sortKey = _sortMode + '-' + _sortDir;
    document.querySelectorAll('#sort-row .chip').forEach(c => c.classList.remove('active'));
    const sortChip = document.getElementById(sortMap[sortKey] || 'sort-marca');
    if (sortChip) sortChip.classList.add('active');
  } catch(e) {}
}

let fVends = new Set(['TODAS']), fMarcas = new Set(), fCat = '', fSearch = '', fStatus = '', fOrigem = '';
let modalId = null;
const SEEN = new Set();
let fbUnsub = null;

// ── Inactivity detector ──────────────────────────
let _idleTimer = null;
const IDLE_TIMEOUT = 5 * 60 * 1000; // 5 minutos

// ── Usuário logado ──────────────────────────
let _usuarioLogado = null;

function getNomeUsuario() {
  if (_usuarioLogado && _usuarioLogado.displayName) return _usuarioLogado.displayName;
  if (_usuarioLogado && _usuarioLogado.email) return _usuarioLogado.email.split('@')[0];
  return getNomeUsuario();
}

function resetIdleTimer() {
  if (_idleTimer) clearTimeout(_idleTimer);
  // Se estava desconectado, reconecta silenciosamente uma vez
  if (!fbUnsub && window._db) {
    fbListen();
  }
  _idleTimer = setTimeout(() => {
    if (fbUnsub) { fbUnsub(); fbUnsub = null; }
  }, IDLE_TIMEOUT);
}

// Detectar qualquer interação do usuário
['touchstart','touchmove','click','keydown','scroll'].forEach(ev => {
  document.addEventListener(ev, resetIdleTimer, { passive: true });
});
window._pdfMarcasSel = new Set();

function setOrigem(o, btn) {
  fOrigem = o;
  document.querySelectorAll('#chip-origem-todos, #chip-origem-br, #chip-origem-usa').forEach(c => c.classList.remove('active'));
  btn.classList.add('active');
  salvarFiltros();
  renderGrid();
}

function editarMesLabel(tipo) {
  const elId = 'label-mes-' + tipo;
  const el = document.getElementById(elId);
  const atual = el.textContent;
  const inp = document.createElement('input');
  inp.value = atual;
  inp.style.cssText = 'font-size:11px;border:none;border-bottom:0.5px solid currentColor;background:transparent;outline:none;width:70px;font-family:inherit;color:inherit';
  el.innerHTML = '';
  el.appendChild(inp);
  inp.focus();
  inp.select();
  const save = () => {
    const val = inp.value.trim() || (tipo === 'br' ? 'Mês BR' : 'Mês USA');
    el.textContent = val;
    localStorage.setItem('mes_label_' + tipo, val);
    if (window._db) {
      window._db.collection('config').doc('app').set({['mesLabel_'+tipo]: val}, {merge: true});
    }
  };
  inp.addEventListener('blur', save);
  inp.addEventListener('keydown', e => { if (e.key === 'Enter') inp.blur(); });
}

function editarSubtitulo() {
  const el = document.getElementById('subtitulo');
  const atual = el.textContent;
  const inp = document.createElement('input');
  inp.value = atual;
  inp.style.cssText = 'font-size:10px;color:#7a0b1e;border:none;border-bottom:0.5px solid #f5c4c4;background:transparent;outline:none;width:160px;font-family:inherit;letter-spacing:0.5px';
  el.innerHTML = '';
  el.appendChild(inp);
  inp.focus();
  inp.select();
  const save = () => {
    const val = inp.value.trim() || 'Faltantes — Junho 2026';
    el.textContent = val;
    localStorage.setItem('app_subtitulo', val);
    // Sync to Firebase with history
    if (window._db) {
      const now = new Date().toLocaleString('pt-BR',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'});
      const who = getNomeUsuario();
      window._db.collection('config').doc('app').set({subtitulo: val}, {merge: true});
      window._db.collection('config').doc('versoes').get().then(doc => {
        const hist = doc.exists ? (doc.data().lista || []) : [];
        hist.unshift({titulo: val, who, time: now});
        window._db.collection('config').doc('versoes').set({lista: hist.slice(0,20)});
      }).catch(e => console.log('version history error:', e));
    }
  };
  inp.onblur = save;
  inp.onkeydown = e => { if (e.key === 'Enter') inp.blur(); if (e.key === 'Escape') { el.textContent = atual; } };
}

let _addTams = [];

function abrirModalAdd() {
  _addTams = [{tam: '', qty: 1}];
  document.getElementById('add-nome').value = '';
  document.getElementById('add-marca').value = '';
  document.getElementById('add-valor').value = '';
  _addFotoBase64 = '';
  document.getElementById('add-foto-preview').innerHTML = '📷';
  document.getElementById('add-foto-input').value = '';
  renderAddTams();
  document.getElementById('modal-add-bg').style.display = 'flex';
  setTimeout(() => document.getElementById('add-nome').focus(), 200);
}

function fecharModalAdd() {
  document.getElementById('modal-add-bg').style.display = 'none';
}

function renderAddTams() {
  const list = document.getElementById('add-tams-list');
  if (!list) return;
  list.innerHTML = '';
  _addTams.forEach((t, i) => {
    const row = document.createElement('div');
    row.style.cssText = 'display:flex;gap:8px;align-items:center';
    row.innerHTML =
      '<input type="text" placeholder="Tam (ex: M, GG, 38)" value="'+t.tam+'" '+
      'style="flex:1;border:0.5px solid #ede0d4;border-radius:10px;padding:8px 12px;font-size:13px;font-family:inherit;outline:none;background:#fdf8f4;color:#1a1a1a">' +
      '<div style="display:flex;align-items:center;gap:6px;border:0.5px solid #ede0d4;border-radius:10px;padding:6px 10px;background:#fdf8f4">'+
      '<button style="background:none;border:none;color:#7a0b1e;font-size:16px;cursor:pointer;padding:0;line-height:1">−</button>'+
      '<span style="min-width:18px;text-align:center;font-size:13px;font-weight:600;color:#7a0b1e">'+t.qty+'</span>'+
      '<button style="background:none;border:none;color:#7a0b1e;font-size:16px;cursor:pointer;padding:0;line-height:1">+</button>'+
      '</div>'+
      (i > 0 ? '<button style="background:none;border:none;color:#c4a898;font-size:16px;cursor:pointer;padding:0">×</button>' : '<div style="width:20px"></div>');
    const inp = row.querySelector('input');
    inp.addEventListener('input', () => { _addTams[i].tam = inp.value.trim(); });
    const btns = row.querySelectorAll('button');
    btns[0].addEventListener('click', () => { _addTams[i].qty = Math.max(1, _addTams[i].qty-1); renderAddTams(); });
    btns[1].addEventListener('click', () => { _addTams[i].qty++; renderAddTams(); });
    if (i > 0) btns[2].addEventListener('click', () => { _addTams.splice(i,1); renderAddTams(); });
    list.appendChild(row);
  });
}

function adicionarTamanho() {
  _addTams.push({tam: '', qty: 1});
  renderAddTams();
}

function addQtyChange(d) {} // kept for compatibility

let _addFotoBase64 = '';

function previewFoto(input) {
  const file = input.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    _addFotoBase64 = e.target.result;
    const preview = document.getElementById('add-foto-preview');
    preview.innerHTML = '';
    const img = document.createElement('img');
    img.src = _addFotoBase64;
    img.style.cssText = 'width:100%;height:100%;object-fit:cover;border-radius:10px';
    preview.appendChild(img);
  };
  reader.readAsDataURL(file);
}

function salvarNovoItem() {
  const nome = document.getElementById('add-nome').value.trim();
  if (!nome) { document.getElementById('add-nome').focus(); return; }
  const marca = document.getElementById('add-marca').value.trim();
  const valor = parseFloat(document.getElementById('add-valor').value) || 0;
  const newId = PRODUTOS.length;
  // Build tams from _addTams
  const tams = {};
  let totalQty = 0;
  _addTams.forEach(t => {
    const key = t.tam || 'Único';
    tams[key] = (tams[key]||0) + t.qty;
    totalQty += t.qty;
  });
  const hasOnlyUnico = Object.keys(tams).length === 1 && tams['Único'];
  const novoItem = {
    _id: newId, n: nome, m: marca, vs: [], v: valor, vt: valor, vmin: valor, vmax: valor,
    q: totalQty, qty: totalQty, f: _addFotoBase64, c: '', nok: false, comments: [],
    tams: hasOnlyUnico ? {'Único': totalQty} : tams,
    tams_str: hasOnlyUnico ? '' : Object.entries(tams).map(([t,q])=>q>1?t+'('+q+')':t).join(' · '),
    nokTams: {}, _manual: true
  };
  PRODUTOS.push(novoItem);
  _addFotoBase64 = '';
  document.getElementById('add-foto-preview').innerHTML = '📷';
  document.getElementById('add-foto-input').value = '';
  fecharModalAdd();
  renderGrid();
  // Save to Firebase
  fbSave(newId);
}

// ── Offline indicator ──────────────────────
window.addEventListener('online',  () => { document.getElementById('offline-banner').style.display='none'; document.querySelector('.main-content') && (document.querySelector('.main-content').style.paddingTop=''); });
window.addEventListener('offline', () => { document.getElementById('offline-banner').style.display='block'; });
if (!navigator.onLine) document.addEventListener('DOMContentLoaded', () => { document.getElementById('offline-banner').style.display='block'; });

let _isDark = localStorage.getItem('dark_mode') === '1';
function toggleDark() {
  _isDark = !_isDark;
  document.body.classList.toggle('dark', _isDark);
  (document.getElementById('btn-dark')||{}).textContent = _isDark ? '☀️' : '🌙';
  localStorage.setItem('dark_mode', _isDark ? '1' : '0');
}

let _gridCols = 2;
let _sortMode = 'marca';
let _sortDir = 'asc';

function setStatus(s, btn) {
  fStatus = s;
  document.querySelectorAll('#status-row .chip').forEach(c => c.classList.remove('active'));
  btn.classList.add('active');
  salvarFiltros();
  renderGrid();
}

function setSort(mode, btn) {
  _sortMode = mode.startsWith('valor') ? 'valor' : mode.startsWith('qty') ? 'qty' : 'marca';
  _sortDir  = mode.endsWith('desc') ? 'desc' : 'asc';
  document.querySelectorAll('#sort-row .chip').forEach(c => c.classList.remove('active'));
  btn.classList.add('active');
  salvarFiltros();
  renderGrid();
}
function toggleGrid() {
  const cols = [2, 3, 1];
  const icons = ['⊞', '⊟', '▤'];
  _gridCols = cols[(cols.indexOf(_gridCols) + 1) % cols.length];
  (document.getElementById('btn-grid')||{}).textContent = icons[cols.indexOf(_gridCols)];
  document.getElementById('grid').style.gridTemplateColumns = `repeat(${_gridCols}, 1fr)`;
}

function resolverFoto(raw) {
  if (!raw) return '';
  const s = raw.trim();
  if (!s) return '';
  // Se for um link do Drive, converter normalmente
  if (s.startsWith('http')) return converterLinkDrive(s);
  // Se for nome de arquivo, buscar no foto_map
  try {
    const fotoMap = JSON.parse(localStorage.getItem('foto_map')||'{}');
    if (fotoMap[s]) return fotoMap[s];
    if (fotoMap[s.toLowerCase()]) return fotoMap[s.toLowerCase()];
    // Tentar sem extensão
    const semExt = s.replace(/\.[^/.]+$/, '');
    if (fotoMap[semExt]) return fotoMap[semExt];
    if (fotoMap[semExt.toLowerCase()]) return fotoMap[semExt.toLowerCase()];
  } catch(e) {}
  // Fallback: tentar como ID do Drive direto
  return s.length > 10 ? `https://drive.google.com/thumbnail?id=${s}&sz=w1000` : '';
}

function converterLinkDrive(url) {
  if (!url) return url;
  url = url.trim();
  let id = null;
  const m1 = url.match(/drive\.google\.com\/file\/d\/([a-zA-Z0-9_-]+)/);
  if (m1) id = m1[1];
  const m2 = url.match(/drive\.google\.com\/open\?id=([a-zA-Z0-9_-]+)/);
  if (m2) id = m2[1];
  const m3 = url.match(/drive\.google\.com\/(?:uc|thumbnail)\?(?:export=view&)?id=([a-zA-Z0-9_-]+)/);
  if (m3) id = m3[1];
  const m4 = url.match(/lh3\.googleusercontent\.com\/d\/([a-zA-Z0-9_-]+)/);
  if (m4) id = m4[1];
  if (id) return `https://lh3.googleusercontent.com/d/${id}=w1000`;
  return url;
}

function abbrev(n, marca) {
  if (marca && marca.trim()) return marca.trim().charAt(0).toUpperCase();
  const w = (n||'').split(' ').filter(x => x.length > 2 && !/^(de|da|do|em|com|para|a|e|o|as|os)$/i.test(x));
  const result = ((w[0]?.[0]||'') + (w[1]?.[0]||'')).toUpperCase();
  return result || '?';
}

function fmtVal(v) {
  return 'R$ ' + parseFloat(v||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});
}

function getFiltered() {
  const q = fSearch.toLowerCase();
  const minQty = parseInt(document.getElementById('filter-qty')?.value) || 0;
  return PRODUTOS.filter(p => {
    if (!fVends.has('TODAS') && !(p.vs||[]).some(v => fVends.has(v.toUpperCase()))) return false;
    if (fMarcas.size > 0 && !fMarcas.has((p.m||'').trim())) return false;
    if (fCat && (p.c||'').trim() !== fCat) return false;
    if (fStatus === 'nok'    && !p.nok) return false;
    if (fStatus === 'compra' && !p.em_compra) return false;
    if (fStatus === 'eua'    && !p.est_eua) return false;
    if (fStatus === 'br'     && !p.est_br) return false;
    if (fOrigem && p.origem !== fOrigem) return false;
    if (q && !p.n.toLowerCase().includes(q) && !(p.m||'').toLowerCase().includes(q) && !(p.vs||[]).some(v=>v.toLowerCase().includes(q))) return false;
    if (minQty > 0 && (p.qty||p.q||0) < minQty) return false;
    return true;
  });
}


function getFiltradosOrdenados() {
  let prods = getFiltered();
  prods.sort((a,b) => {
    const dir = _sortDir === 'asc' ? 1 : -1;
    if (_sortMode === 'valor') return ((parseFloat(a.vt||a.v)||0) - (parseFloat(b.vt||b.v)||0)) * dir;
    if (_sortMode === 'qty')   return ((a.qty||a.q||0) - (b.qty||b.q||0)) * dir;
    const ma = (a.m||'').trim();
    const mb = (b.m||'').trim();
    const semMarcaA = ma === '';
    const semMarcaB = mb === '';
    if (semMarcaA && !semMarcaB) return 1;
    if (!semMarcaA && semMarcaB) return -1;
    if (semMarcaA && semMarcaB) return a.n.localeCompare(b.n,'pt-BR') * dir;
    const numA = /^\d/.test(ma);
    const numB = /^\d/.test(mb);
    if (numA && !numB) return -1 * dir;
    if (!numA && numB) return 1 * dir;
    const mc = ma.localeCompare(mb,'pt-BR',{numeric:true});
    if (mc !== 0) return mc * dir;
    return a.n.localeCompare(b.n,'pt-BR') * dir;
  });
  return prods;
}

function renderGrid() {
  try {
  const searchEl = document.getElementById('search-input');
  const grid = document.getElementById('grid');
  const empty = document.getElementById('empty');
  if (!searchEl || !grid || !empty) return; // DOM não pronto ainda
  fSearch = searchEl.value;
  let prods = getFiltradosOrdenados();
  // Atualizar contadores nas categorias
  document.querySelectorAll('#cat-row .chip:not(#chip-all-cat)').forEach(btn => {
    const match = btn.getAttribute('onclick')?.match(/setCat\('([^']+)'/);
    if (!match) return;
    const cat = match[1];
    const count = PRODUTOS.filter(p => (p.c||'').trim() === cat).length;
    btn.textContent = count > 0 ? `${cat} ${count}` : cat;
  });
  const countNum = document.getElementById('count-num');
  if (countNum) countNum.textContent = prods.length;
  const totalV = prods.filter(p => !p.nok).reduce((a,p) => {
    const val = parseFloat(p.vmin||p.vt||p.v)||0;
    // Count only non-NOK tams
    const nokT = p.nokTams || {};
    const tams = p.tams ? Object.entries(p.tams) : null;
    const qty = tams
      ? tams.filter(([t]) => !nokT[t]).reduce((s,[,q])=>s+q, 0)
      : (p.qty||p.q||0);
    return a + val * qty;
  }, 0);
  const totalEl = document.getElementById('header-total');
  if (totalEl) totalEl.textContent = '';
  const tv = prods.reduce((a,p)=>{
    const val = parseFloat(p.vmin||p.vt||p.v)||0;
    return a + val * (p.qty||p.q||0);
  }, 0);
  const cvEl = document.getElementById('count-val'); if (cvEl) cvEl.textContent = fmtVal(tv);
  // Update header-meta with live filtered totals
  const headerMeta = document.getElementById('header-meta');
  // Contador por vendedora
  const vendTotal = document.getElementById('header-vend-total');
  if (vendTotal) {
    const soUmaVend = !fVends.has('TODAS') && fVends.size === 1;
    if (soUmaVend) {
      const vend = [...fVends][0];
      const prodsDaVend = PRODUTOS.filter(p => (p.vs||[]).includes(vend));
      const totalVend = prodsDaVend.filter(p => !p.nok).reduce((a,p) => {
        const val = parseFloat(p.vmin||p.vt||p.v)||0;
        const nokT = p.nokTams || {};
        const tams = p.tams ? Object.entries(p.tams) : null;
        const qty = tams ? tams.filter(([t])=>!nokT[t]).reduce((s,[,q])=>s+q,0) : (p.qty||p.q||0);
        return a + val * qty;
      }, 0);
      vendTotal.textContent = vend.charAt(0) + vend.slice(1).toLowerCase() + ': R$ ' + totalVend.toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});
      vendTotal.style.display = '';
    } else {
      vendTotal.style.display = 'none';
    }
  }
  if (headerMeta) {
    const totalItens = PRODUTOS.length;
    const totalGeral = PRODUTOS.filter(p => !p.nok).reduce((a,p) => {
      const val = parseFloat(p.vmin||p.vt||p.v)||0;
      const nokT = p.nokTams || {};
      const tams = p.tams ? Object.entries(p.tams) : null;
      const qty = tams ? tams.filter(([t])=>!nokT[t]).reduce((s,[,q])=>s+q,0) : (p.qty||p.q||0);
      return a + val * qty;
    }, 0);
    const isFiltrado = !fVends.has('TODAS') || fMarcas.size > 0 || fCat || fSearch;
    if (isFiltrado) {
      headerMeta.textContent = prods.length + ' de ' + totalItens + ' itens · R$ ' + totalV.toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});
    } else {
      headerMeta.textContent = totalItens + ' itens · R$ ' + totalGeral.toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});
    }
  }

  if (!PRODUTOS.length) {
    grid.innerHTML = '';
    empty.style.display = 'flex';
    empty.innerHTML = '<div style="text-align:center;padding:40px 20px"><div style="font-size:48px;margin-bottom:16px">📦</div><div style="font-size:16px;font-weight:700;color:var(--text);margin-bottom:8px">Nenhum produto ainda</div><div style="font-size:13px;color:var(--text3);margin-bottom:20px">Importe um CSV na aba Dados para começar</div><button onclick="goTab(\'upload\')"